{
	"name" : "gigaionllc/nanophp",
	"type" : "library",
	"description" : "Dependency-free PHP libraries and tools for Nano currency",
	"keywords" : [
		"nano",
		"raiblocks",
		"php",
		"cli",
		"rpc",
		"ipc",
		"websocket",
		"wallet",
		"tools",
		"blocks"
	],
	"homepage" : "https://github.com/GigaionLLC/NanoPHP",
	"license" : "MIT",
	"authors" : [{
			"name" : "Gigaion, LLC",
			"role" : "Maintainer"
		}, {
			"name" : "MikeRow",
			"role" : "Original developer (MikeRow/NanoPHP, archived)"
		}
	],
	"support" : {
		"issues" : "https://github.com/GigaionLLC/NanoPHP/issues",
		"source" : "https://github.com/GigaionLLC/NanoPHP"
	},
	"minimum-stability" : "stable",
	"require" : {
		"php-64bit" : "^8.1",
		"ext-bcmath" : "*"
	},
	"suggest" : {
		"ext-openssl" : "Required only for RPC over https and WebSocket over wss",
		"google/flatbuffers" : "Legacy: only for NanoIPC FlatBuffers preprocessing (modern nodes use JSON)"
	},
	"autoload" : {
		"psr-4" : {
			"GigaionLLC\\NanoPHP\\" : "src/"
		}
	}
}
